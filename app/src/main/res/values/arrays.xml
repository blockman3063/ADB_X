<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="xposed_scope">
        <!--
            Scope is intentionally Settings-only. Earlier builds also
            listed "system" (LSPosed magic for system_server) to drive
            WiFi auto-toggle from a NetworkCallback inside the server.
            On this ROM LSPosed never injected system_server, so that
            branch never ran — it only forced a full reboot every time
            the hook changed. Everything that actually works (WiFi list
            dump, pairing-code capture) lives in the Settings process,
            which can be restarted with a force-stop instead of a reboot.
        -->
        <item>com.android.settings</item>
    </string-array>
</resources>
